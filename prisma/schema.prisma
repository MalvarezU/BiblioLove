// Esquema de Prisma para el Sistema de Gestion de Biblioteca (BiblioLove)
// Documentacion: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Book {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId Int      @map("category") @db.SmallInt
  genreId    Int      @map("genre") @db.SmallInt
  title      String   @db.VarChar(255)
  authorId   Int      @map("author")

  category Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  genre    Genre    @relation(fields: [genreId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  author   Author   @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items    Item[]

  @@map("book")
}

model Genre {
  id    Int    @id @default(autoincrement()) @db.SmallInt
  name  String @db.VarChar(255)
  books Book[]

  @@map("genre")
}

model Category {
  id    Int    @id @default(autoincrement()) @db.SmallInt
  name  String @db.VarChar(255)
  books Book[]

  @@map("category")
}

model Author {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(255)
  lastName  String  @map("last_name") @db.VarChar(255)
  biography String? @db.Text
  books     Book[]

  @@map("author")
}

model Item {
  id          String    @id @default(uuid()) @db.Uuid
  bookId      String    @map("book") @db.Uuid
  /// Valores permitidos: Disponible | Reservado | En préstamo | Perdido
  status      String    @default("Disponible") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Date
  updatedAt   DateTime? @map("updated_at") @db.Date
  enabled     Boolean   @default(true)
  deleted     Boolean   @default(false)
  createdById String    @map("created_by") @db.Uuid
  publisher   String    @db.VarChar(255)

  book         Book          @relation(fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy    User          @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservations Reservation[]
  checkouts    Checkout[]

  @@map("item")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  lastName  String?  @map("last_name") @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(255)
  photo     String?  @db.VarChar(255)
  enabled   Boolean  @default(true)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Date
  updatedAt DateTime @updatedAt @map("updated_at") @db.Date
  role      String   @default("USER") @db.VarChar(255)

  items        Item[]        @relation("ItemCreatedBy")
  reservations Reservation[]
  checkouts    Checkout[]

  @@map("user")
}

model Reservation {
  id          String   @id @default(uuid()) @db.Uuid
  itemId      String   @map("item") @db.Uuid
  userId      String   @map("user") @db.Uuid
  issuedDate  DateTime @map("issued_date") @db.Date
  minCheckout DateTime @map("min_checkout") @db.Date
  maxCheckout DateTime @map("max_checkout") @db.Date
  /// Valores permitidos: Activa | Cancelada | Cumplida | Reclamado
  status      String   @default("Activa") @db.VarChar(255)

  item      Item       @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checkouts Checkout[]

  @@map("reservation")
}

model Checkout {
  id            String    @id @default(uuid()) @db.Uuid
  itemId        String    @map("item") @db.Uuid
  userId        String    @map("user") @db.Uuid
  checkoutDate  DateTime  @map("checkout_date") @db.Date
  dueDate       DateTime  @map("due_date") @db.Date
  returnDate    DateTime? @map("return_date") @db.Date
  reservationId String?   @map("reservation") @db.Uuid
  /// Valores permitidos: Prestado | Entregado | Entregado con retraso
  status        String    @default("Prestado") @db.VarChar(255)

  item        Item         @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("checkout")
}
