// Esquema de Prisma para el Sistema de Gestion de Biblioteca (BiblioLove)
// Documentacion: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Roles disponibles en el sistema
enum Enum_Role {
  ADMIN
  USER
}

// Tipos de movimiento de inventario en la biblioteca
enum Enum_Movimiento_Tipo {
  ENTRADA // Ingreso de libros al inventario
  SALIDA  // Prestamo o retiro de libros del inventario
}

// Usuario del sistema con autenticacion por email y password
model User {
  id         String      @id @default(cuid())
  name       String
  email      String      @unique
  lastName   String?
  password   String
  deleted    Boolean     @default(false)
  enabled    Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  role       Enum_Role   @default(USER)
  profile    Profile?
  // Maestros creados por este usuario
  maestros   Maestro[]
  // Movimientos registrados por este usuario
  movimientos Movimiento[]
}

// Perfil extendido del usuario con datos de contacto
model Profile {
  id        String   @id @default(cuid())
  address   String
  phone     String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
}

// Maestro representa un tipo de libro o material en la biblioteca.
// Cada maestro tiene un saldo que refleja las unidades disponibles.
model Maestro {
  id          String       @id @default(cuid())
  nombre      String
  // Saldo actual de unidades disponibles en inventario
  saldo       Float        @default(0)
  deleted     Boolean      @default(false)
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  // Usuario que creo este maestro
  creadoPor   User         @relation(fields: [userId], references: [id])
  userId      String
  // Movimientos asociados a este maestro
  movimientos Movimiento[]
}

// Movimiento registra cada transaccion de entrada o salida de un maestro.
// El saldo del maestro se recalcula sumando todos sus movimientos.
model Movimiento {
  id         String               @id @default(cuid())
  tipo       Enum_Movimiento_Tipo
  cantidad   Float
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  // Maestro al que pertenece este movimiento
  maestro    Maestro              @relation(fields: [maestroId], references: [id])
  maestroId  String
  // Usuario que registro el movimiento
  ejecutadoPor User              @relation(fields: [userId], references: [id])
  userId       String
}
